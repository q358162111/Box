# Windows thumbnail cache
Thumbs.db
.DS_Store


# Built application files
*.apk
*.aar
*.ap_
*.aab

# local-maven 是项目内置的离线仓库（预置 JitPack 不稳定构件），其 aar 必须入库，
# 否则任何人 clone 后都会因缺件在依赖解析阶段构建失败。上面 *.aar 的例外。
!local-maven/**/*.aar

proguardMapping.txt

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Native dynamic libs (dev-host artifacts, not runtime deps)
*.dylib

# Local signing secrets (never track)
keystore.properties
release.keystore
test.keystore
#  Uncomment the following line in case you need and you don't have the release build type files in your app
# release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

